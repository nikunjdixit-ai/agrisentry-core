# ============================================================
# AgriSentry - Environment Configuration Template
# Copy this file to .env and configure your local/production values.
# NEVER commit actual secrets or credentials to source control.
# ============================================================

# ------------------------------------------------------------
# Twilio Telephony / Voice IVR Configuration
# Required for live cellular phone calls.
# Obtain from your Twilio Console (https://console.twilio.com)
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Public URL where Twilio webhooks can reach this FastAPI server.
# For local testing, use ngrok or Localtunnel (e.g., https://abcd-123.ngrok-free.app).
# When testing locally without a tunnel, leaving this blank will cause the IVR
# to speak back the Hindi advice directly via Twilio <Say> TTS.
PUBLIC_BASE_URL=

# ------------------------------------------------------------
# AgriSentry Voice & Diagnosis Defaults
# ------------------------------------------------------------
DEFAULT_VOICE_CROP=cotton
DEFAULT_VOICE_REGION=Punjab
DEFAULT_VOICE_LANGUAGE=hi

# ------------------------------------------------------------
# Telemetry Defaults (Barabanki / Lucknow Agricultural Region)
# ------------------------------------------------------------
DEFAULT_LATITUDE=26.8467
DEFAULT_LONGITUDE=80.9462
